{
	"compatibility_date": "2026-05-29",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "cyber-digest",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cyber_daily",
			"database_id": "d269b677-ba44-4335-aba7-e1fb9c3cbd23"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	}
}