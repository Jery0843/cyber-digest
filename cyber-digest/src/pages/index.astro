---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import PostGrid from '../components/PostGrid.astro';
import type { Post } from '../lib/types';
import { getLatestPosts, getTodaysPosts, getPostCount } from '../lib/db';

import { getDB } from '../lib/env';
const db = getDB();
let todayPosts: Post[] = [];
let recentPosts: Post[] = [];
let totalCount = 0;

if (db) {
  todayPosts = await getTodaysPosts(db);
  recentPosts = await getLatestPosts(db, 9);
  totalCount = await getPostCount(db);
}

const today = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout>
  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="hero__bg">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="hero__orb hero__orb--1" aria-hidden="true"></div>
      <div class="hero__orb hero__orb--2" aria-hidden="true"></div>
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <div class="hero__status">
          <span class="hero__pulse"></span>
          <span class="hero__status-text">LIVE INTELLIGENCE FEED</span>
        </div>
        <h1 class="hero__title">
          <span class="hero__title-line">Cybersecurity</span>
          <span class="hero__title-accent" data-text="Daily Digest">Daily Digest</span>
        </h1>
        <p class="hero__subtitle">{today}</p>
        <p class="hero__description">Automated threat intelligence from NVD, CISA, GitHub Security, and trusted sources. AI-generated analysis you can verify.</p>
        <div class="hero__stats">
          <div class="hero__stat">
            <span class="hero__stat-value">{todayPosts.length}</span>
            <span class="hero__stat-label">Today's Posts</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">{totalCount}</span>
            <span class="hero__stat-label">Total Published</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">4</span>
            <span class="hero__stat-label">Active Sources</span>
          </div>
        </div>
      </div>
      <div class="hero__terminal">
        <div class="terminal__header">
          <div class="terminal__dots">
            <span class="terminal__dot terminal__dot--red"></span>
            <span class="terminal__dot terminal__dot--yellow"></span>
            <span class="terminal__dot terminal__dot--green"></span>
          </div>
          <span class="terminal__title">cyber-digest — cron.log</span>
        </div>
        <div class="terminal__body">
          <p><span class="t-cyan">$</span> cron triggered @ 02:00 UTC</p>
          <p><span class="t-muted">[1/6]</span> fetching NVD CVE feed... <span class="t-green">✓</span></p>
          <p><span class="t-muted">[2/6]</span> fetching CISA KEV catalog... <span class="t-green">✓</span></p>
          <p><span class="t-muted">[3/6]</span> fetching GitHub advisories... <span class="t-green">✓</span></p>
          <p><span class="t-muted">[4/6]</span> deduplicating events... <span class="t-green">✓</span></p>
          <p><span class="t-muted">[5/6]</span> ranking by severity... <span class="t-green">✓</span></p>
          <p><span class="t-muted">[6/6]</span> generating posts... <span class="t-green">✓</span></p>
          <p class="t-green">→ {todayPosts.length} posts published</p>
          <p><span class="t-cursor">█</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Threat Radar Divider -->
  <section class="threat-radar" aria-hidden="true">
    <div class="radar__container">
      <div class="radar__ring radar__ring--outer"></div>
      <div class="radar__ring radar__ring--inner"></div>
      <div class="radar__sweep"></div>
      <div class="radar__center"></div>
    </div>
    <div class="radar__label">
      <span class="radar__label-icon">◈</span>
      MONITORING {totalCount}+ THREAT VECTORS
    </div>
  </section>

  <!-- Today's Posts -->
  {todayPosts.length > 0 && (
    <section class="page-content" id="today-posts">
      <div class="container">
        <div class="section-header">
          <p class="section-header__label">Today's Intelligence</p>
          <h2 class="section-header__title">Latest <span>Posts</span></h2>
        </div>
        <PostGrid posts={todayPosts} />
      </div>
    </section>
  )}

  <!-- Recent Posts -->
  <section class="page-content" id="recent-posts" style={todayPosts.length > 0 ? 'padding-top: 0;' : ''}>
    <div class="container">
      <div class="section-header">
        <p class="section-header__label">Recent Intelligence</p>
        <h2 class="section-header__title">All <span>Recent Posts</span></h2>
      </div>
      <PostGrid posts={recentPosts} emptyMessage="No posts yet. The daily cron will publish the first batch soon." />
    </div>
  </section>
</BaseLayout>

<style>
/* ===== HERO ===== */
.hero {
  position: relative;
  padding: var(--space-4xl) 0 var(--space-3xl);
  overflow: hidden;
  min-height: 85vh;
  display: flex;
  align-items: center;
}

.hero__bg {
  position: absolute;
  inset: 0;
  background: var(--gradient-hero);
  z-index: 0;
}

.hero__bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(0, 240, 255, 0.04) 0%, transparent 60%),
    radial-gradient(ellipse at 80% 30%, rgba(168, 85, 247, 0.04) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 100%, rgba(255, 42, 109, 0.03) 0%, transparent 40%);
}

/* Perspective Grid */
.hero__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.3) 40%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.3) 40%, transparent 100%);
}

/* Ambient orbs */
.hero__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
}

.hero__orb--1 {
  width: 400px;
  height: 400px;
  top: -10%;
  right: 10%;
  background: rgba(168, 85, 247, 0.12);
  animation: float-orb 20s ease-in-out infinite alternate;
}

.hero__orb--2 {
  width: 300px;
  height: 300px;
  bottom: -5%;
  left: 5%;
  background: rgba(0, 240, 255, 0.08);
  animation: float-orb 25s ease-in-out infinite alternate-reverse;
}

.hero__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3xl);
  align-items: center;
  z-index: 1;
}

/* Status Badge */
.hero__status {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
  padding: var(--space-xs) var(--space-md);
  background: rgba(0, 240, 255, 0.06);
  border: 1px solid rgba(0, 240, 255, 0.2);
  border-radius: var(--radius-full);
  backdrop-filter: blur(8px);
}

.hero__pulse {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-cyan);
  animation: pulse-glow 2s infinite;
  box-shadow: 0 0 10px var(--accent-cyan);
}

.hero__status-text {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--accent-cyan);
  letter-spacing: 0.15em;
}

/* Title */
.hero__title {
  margin-bottom: var(--space-md);
}

.hero__title-line {
  display: block;
  font-family: var(--font-display);
  font-size: var(--text-6xl);
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.05;
  text-transform: uppercase;
  color: var(--text-primary);
}

.hero__title-accent {
  display: block;
  font-family: var(--font-display);
  font-size: var(--text-6xl);
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.05;
  text-transform: uppercase;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
}

/* Glitch effect layers */
.hero__title-accent::before,
.hero__title-accent::after {
  content: attr(data-text);
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  opacity: 0;
}

.hero__title-accent:hover::before {
  opacity: 0.8;
  animation: glitch-channel 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  color: var(--accent-cyan);
  text-shadow: -2px 0 var(--accent-cyan);
}

.hero__title-accent:hover::after {
  opacity: 0.8;
  animation: glitch-channel 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) reverse both;
  color: var(--accent-magenta);
  text-shadow: 2px 0 var(--accent-magenta);
}

.hero__subtitle {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--text-muted);
  margin-bottom: var(--space-md);
  letter-spacing: 0.05em;
}

.hero__description {
  font-size: var(--text-base);
  color: var(--text-secondary);
  max-width: 500px;
  line-height: 1.8;
  margin-bottom: var(--space-xl);
}

/* Stats */
.hero__stats {
  display: flex;
  gap: var(--space-xl);
}

.hero__stat {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  position: relative;
}

.hero__stat::before {
  content: '';
  position: absolute;
  top: -8px;
  left: 0;
  width: 20px;
  height: 2px;
  background: var(--gradient-accent);
  border-radius: 1px;
}

.hero__stat-value {
  font-family: var(--font-mono);
  font-size: var(--text-3xl);
  font-weight: 700;
  color: var(--accent-cyan);
  text-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
  line-height: 1;
}

.hero__stat-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* ===== TERMINAL ===== */
.hero__terminal {
  background: rgba(8, 10, 20, 0.8);
  border: 1px solid rgba(0, 240, 255, 0.12);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow:
    0 0 40px rgba(0, 0, 0, 0.6),
    0 0 80px rgba(0, 240, 255, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(16px);
  transform-style: preserve-3d;
  perspective: 1000px;
}

.terminal__header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  background: rgba(0, 0, 0, 0.4);
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.terminal__dots {
  display: flex;
  gap: 6px;
}

.terminal__dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  transition: transform 0.2s ease;
}

.terminal__dot:hover {
  transform: scale(1.3);
}

.terminal__dot--red { background: #ff5f57; box-shadow: 0 0 6px rgba(255, 95, 87, 0.4); }
.terminal__dot--yellow { background: #ffbd2e; box-shadow: 0 0 6px rgba(255, 189, 46, 0.4); }
.terminal__dot--green { background: #28c840; box-shadow: 0 0 6px rgba(40, 200, 64, 0.4); }

.terminal__title {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
  letter-spacing: 0.05em;
}

.terminal__body {
  padding: var(--space-lg);
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  line-height: 2;
}

.terminal__body p {
  color: var(--text-secondary);
}

.t-cyan { color: var(--accent-cyan); text-shadow: 0 0 8px rgba(0, 240, 255, 0.3); }
.t-green { color: var(--accent-neon-green); text-shadow: 0 0 8px rgba(5, 255, 161, 0.3); }
.t-muted { color: var(--text-muted); }
.t-cursor {
  color: var(--accent-cyan);
  animation: blink 1s step-end infinite;
}

/* ===== THREAT RADAR ===== */
.threat-radar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-3xl) 0 var(--space-xl);
  position: relative;
  z-index: 1;
}

.radar__container {
  position: relative;
  width: 120px;
  height: 120px;
  margin-bottom: var(--space-lg);
}

.radar__ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(0, 240, 255, 0.12);
}

.radar__ring--outer {
  inset: 0;
}

.radar__ring--inner {
  inset: 20px;
}

.radar__sweep {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(0, 240, 255, 0.15) 30deg,
    transparent 60deg
  );
  animation: radar-sweep 3s linear infinite;
}

.radar__center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-cyan);
  box-shadow: 0 0 12px var(--accent-cyan);
}

.radar__label {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.2em;
}

.radar__label-icon {
  color: var(--accent-cyan);
  font-size: 0.6rem;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 900px) {
  .hero__inner {
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  .hero {
    min-height: auto;
    padding: var(--space-2xl) 0;
  }
  .hero__title-line,
  .hero__title-accent {
    font-size: var(--text-4xl);
  }
}

@media (max-width: 640px) {
  .hero__stats {
    flex-wrap: wrap;
    gap: var(--space-lg);
  }
  .hero__title-line,
  .hero__title-accent {
    font-size: var(--text-3xl);
  }
  .radar__container {
    width: 80px;
    height: 80px;
  }
}
</style>
