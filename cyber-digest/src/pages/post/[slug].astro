---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostGrid from '../../components/PostGrid.astro';
import TagBadge from '../../components/TagBadge.astro';
import type { Post, PostSource, PostWithTags } from '../../lib/types';
import { getPostBySlug, getPostsByType } from '../../lib/db';

const { slug } = Astro.params;
import { getDB } from '../../lib/env';
const db = getDB();

if (!slug || !db) return Astro.redirect('/');

const post = await getPostBySlug(db, slug);
if (!post) return Astro.redirect('/');

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
}

const relatedPosts = await getPostsByType(db, post.type, 3, 0);
const related = relatedPosts.filter(p => p.slug !== post.slug).slice(0, 2);

const siteUrl = 'https://digest.jerome.co.in';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.summary,
  datePublished: post.published_at,
  author: { '@type': 'Organization', name: 'CyberDigest' },
  publisher: { '@type': 'Organization', name: 'CyberDigest' },
  url: `${siteUrl}/post/${post.slug}`,
  keywords: post.tags.join(', '),
});
---
<BaseLayout
  title={`${post.title} — CyberDigest`}
  description={post.summary}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <article class="post-page" id={`post-${post.slug}`}>
    <div class="container container--narrow">
      <!-- Back Link -->
      <a href="/" class="back-link" id="post-back">
        <span class="back-link__arrow">←</span>
        <span>Back to Feed</span>
      </a>

      <!-- Header -->
      <header class="post-page__header">
        <div class="post-page__meta">
          <span class={`type-badge type-badge--${post.type}`}>{post.type}</span>
          <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
        </div>
        <h1 class="post-page__title">{post.title}</h1>
        <p class="post-page__summary">{post.summary}</p>
        {post.tags.length > 0 && (
          <div class="post-page__tags">
            {post.tags.map(t => <TagBadge name={t} />)}
          </div>
        )}
      </header>

      <!-- Info bar -->
      <div class="post-page__info glass-card">
        <div class="info-item">
          <span class="info-label">Confidence</span>
          <span class="info-value">{(post.confidence_score * 10).toFixed(0)}%</span>
        </div>
        <div class="info-item">
          <span class="info-label">Sources</span>
          <span class="info-value">{post.source_count}</span>
        </div>
        <div class="info-item">
          <span class="info-label">Model</span>
          <span class="info-value info-value--mono">{post.model || 'AI'}</span>
        </div>
        <div class="info-item">
          <span class="info-label">Event Date</span>
          <span class="info-value">{post.event_date ? formatDate(post.event_date) : 'N/A'}</span>
        </div>
      </div>

      <!-- Content -->
      <div class="post-content" set:html={post.content} />

      <!-- Sources -->
      {post.sources.length > 0 && (
        <div class="post-page__sources glass-card">
          <h3 class="post-page__sources-title">
            <span class="sources-icon">◈</span>
            Sources
          </h3>
          <ul class="post-page__sources-list">
            {post.sources.map((s: PostSource) => (
              <li>
                <a href={s.source_url} target="_blank" rel="noopener noreferrer">{s.source_name}</a>
                <span class="source-url">{new URL(s.source_url).hostname}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <section class="post-page__related">
        <div class="container">
          <div class="section-header">
            <p class="section-header__label">Related</p>
            <h2 class="section-header__title">More <span>{post.type} posts</span></h2>
          </div>
          <PostGrid posts={related} />
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
.post-page {
  padding: var(--space-3xl) 0;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--text-muted);
  text-decoration: none;
  margin-bottom: var(--space-2xl);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  transition: all 0.3s ease;
}

.back-link:hover {
  color: var(--accent-cyan);
  transform: translateX(-4px);
  text-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
}

.back-link__arrow {
  transition: transform 0.3s ease;
}

.back-link:hover .back-link__arrow {
  transform: translateX(-4px);
}

.post-page__header {
  margin-bottom: var(--space-2xl);
}

.post-page__meta {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

.post-page__meta time {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--text-muted);
}

.post-page__title {
  font-family: var(--font-display);
  font-size: var(--text-4xl);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  margin-bottom: var(--space-md);
}

.post-page__summary {
  font-size: var(--text-lg);
  color: var(--text-secondary);
  line-height: 1.7;
  max-width: 700px;
}

.post-page__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.post-page__info {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-md);
  padding: var(--space-lg);
  margin-bottom: var(--space-2xl);
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.2rem;
  text-align: center;
}

.info-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.info-value {
  font-family: var(--font-sans);
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--accent-cyan);
  text-shadow: 0 0 12px rgba(0, 240, 255, 0.2);
}

.info-value--mono {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
}

.post-page__sources {
  padding: var(--space-xl);
  margin-top: var(--space-2xl);
}

.post-page__sources-title {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 700;
  margin-bottom: var(--space-md);
  color: var(--accent-cyan);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.sources-icon {
  color: var(--accent-cyan);
  font-size: 0.8rem;
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.4);
}

.post-page__sources-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.post-page__sources-list li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) var(--space-md);
  background: rgba(0, 0, 0, 0.2);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  border: 1px solid rgba(255, 255, 255, 0.03);
  transition: all 0.3s ease;
}

.post-page__sources-list li:hover {
  background: rgba(0, 240, 255, 0.04);
  border-color: rgba(0, 240, 255, 0.1);
  transform: translateX(4px);
}

.post-page__sources-list a {
  color: var(--text-primary);
  font-weight: 500;
}

.source-url {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
}

.post-page__related {
  padding: var(--space-3xl) 0;
  border-top: 1px solid var(--border-subtle);
  margin-top: var(--space-3xl);
}

@media (max-width: 640px) {
  .post-page__info {
    grid-template-columns: repeat(2, 1fr);
  }
  .post-page__title {
    font-size: var(--text-3xl);
  }
}
</style>
