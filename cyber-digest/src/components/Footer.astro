---
const year = new Date().getFullYear();
const marqueeItems = [
  'LIVE FEED',
  'CVE ALERTS',
  'THREAT INTEL',
  'ZERO-DAY WATCH',
  'EXPLOIT DB',
  'MITRE ATT&CK',
  'CISA KEV',
  'AI ANALYSIS',
  'NVD MONITOR',
  'OSINT FEEDS',
];
---
<footer class="footer" id="site-footer">
  <!-- Marquee Ticker -->
  <div class="footer__marquee" aria-hidden="true">
    <div class="footer__marquee-track">
      {[...marqueeItems, ...marqueeItems].map(item => (
        <span class="footer__marquee-item">
          <span class="footer__marquee-dot">◆</span>
          {item}
        </span>
      ))}
    </div>
  </div>

  <!-- Scan Line Effect -->
  <div class="footer__scanline" aria-hidden="true"></div>

  <div class="footer__inner container">
    <div class="footer__top">
      <div class="footer__brand">
        <span class="footer__name">
          <span class="footer__name-accent">Cyber</span>Digest
        </span>
        <p class="footer__tagline">Automated daily cybersecurity intelligence powered by trusted sources and AI.</p>
        <div class="footer__status">
          <span class="footer__status-dot"></span>
          <span class="footer__status-text">SYSTEMS OPERATIONAL</span>
        </div>
      </div>
      <div class="footer__links">
        <div class="footer__col">
          <h4 class="footer__col-title">Content</h4>
          <a href="/news">Daily News</a>
          <a href="/blog">Blog Posts</a>
          <a href="/articles">Deep Analysis</a>
        </div>
        <div class="footer__col">
          <h4 class="footer__col-title">More</h4>
          <a href="/archive">Archive</a>
          <a href="/rss.xml">RSS Feed</a>
          <a href="/sitemap.xml">Sitemap</a>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__copy">&copy; {year} CyberDigest. Automated &amp; open-source.</p>
      <p class="footer__stack">Built on <span class="footer__stack-accent">Cloudflare</span></p>
    </div>
  </div>
</footer>

<style>
.footer {
  position: relative;
  border-top: 1px solid rgba(0, 240, 255, 0.08);
  background: linear-gradient(180deg, var(--bg-void) 0%, #040610 100%);
  padding: 0 0 var(--space-xl);
  overflow: hidden;
}

/* Scan Line */
.footer__scanline {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(
    0deg,
    transparent 0px,
    transparent 2px,
    rgba(0, 240, 255, 0.015) 2px,
    rgba(0, 240, 255, 0.015) 4px
  );
  z-index: 1;
}

/* Marquee Ticker */
.footer__marquee {
  width: 100%;
  overflow: hidden;
  padding: var(--space-md) 0;
  border-bottom: 1px solid rgba(0, 240, 255, 0.06);
  background: rgba(0, 240, 255, 0.02);
  position: relative;
  z-index: 2;
}

.footer__marquee-track {
  display: flex;
  gap: var(--space-2xl);
  white-space: nowrap;
  animation: marquee-scroll 30s linear infinite;
  width: max-content;
}

.footer__marquee:hover .footer__marquee-track {
  animation-play-state: paused;
}

.footer__marquee-item {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  transition: color 0.3s ease;
}

.footer__marquee:hover .footer__marquee-item {
  color: var(--accent-cyan);
}

.footer__marquee-dot {
  font-size: 0.5rem;
  color: var(--accent-cyan);
  opacity: 0.4;
}

/* Footer Content */
.footer__inner {
  position: relative;
  z-index: 2;
  padding-top: var(--space-3xl);
}

.footer__top {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3xl);
  margin-bottom: var(--space-2xl);
  flex-wrap: wrap;
}

.footer__brand {
  max-width: 360px;
}

.footer__name {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 700;
  display: block;
  margin-bottom: var(--space-sm);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.footer__name-accent {
  background: var(--gradient-text);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.footer__tagline {
  color: var(--text-muted);
  font-size: var(--text-sm);
  line-height: 1.7;
  margin-bottom: var(--space-md);
}

.footer__status {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-xs) var(--space-md);
  background: rgba(5, 255, 161, 0.06);
  border: 1px solid rgba(5, 255, 161, 0.15);
  border-radius: var(--radius-full);
}

.footer__status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-neon-green);
  box-shadow: 0 0 8px var(--accent-neon-green);
  animation: pulse-glow 2s ease-in-out infinite;
}

.footer__status-text {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 600;
  color: var(--accent-neon-green);
  letter-spacing: 0.15em;
}

.footer__links {
  display: flex;
  gap: var(--space-3xl);
}

.footer__col {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.footer__col-title {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--text-muted);
  margin-bottom: var(--space-xs);
}

.footer__col a {
  color: var(--text-secondary);
  font-size: var(--text-sm);
  transition: all 0.3s ease;
  position: relative;
}

.footer__col a:hover {
  color: var(--accent-cyan);
  text-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
  transform: translateX(4px);
}

.footer__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--space-xl);
  border-top: 1px solid rgba(255, 255, 255, 0.04);
}

.footer__copy, .footer__stack {
  font-size: var(--text-xs);
  color: var(--text-muted);
  font-family: var(--font-mono);
}

.footer__stack-accent {
  color: var(--accent-cyan);
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.3);
}

@media (max-width: 640px) {
  .footer__top {
    flex-direction: column;
    gap: var(--space-xl);
  }
  .footer__bottom {
    flex-direction: column;
    gap: var(--space-sm);
    text-align: center;
  }
  .footer__marquee-track {
    animation-duration: 20s;
  }
}
</style>
