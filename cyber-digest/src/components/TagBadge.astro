---
interface Props { name: string; }
const { name } = Astro.props;
---
<a href={`/tags/${encodeURIComponent(name)}`} class="tag-badge" id={`tag-${name.replace(/\s+/g, '-').toLowerCase()}`}># {name}</a>
<style>
.tag-badge{display:inline-flex;align-items:center;gap:0.2rem;padding:0.2rem 0.55rem;border-radius:var(--radius-full);font-family:var(--font-mono);font-size:0.7rem;font-weight:500;color:var(--accent-cyan);background:rgba(6,182,212,0.1);border:1px solid rgba(6,182,212,0.2);transition:all var(--transition-fast);text-decoration:none}
.tag-badge:hover{background:rgba(6,182,212,0.2);border-color:rgba(6,182,212,0.4);color:var(--accent-cyan);transform:translateY(-1px)}
</style>
