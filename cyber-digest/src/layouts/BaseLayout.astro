---
// =============================================================================
// CyberDigest — Base Layout v2.0 (Immersive Premium Edition)
// =============================================================================
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ParticleField from '../components/ParticleField.astro';
import Animations from '../components/Animations.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
}

const {
  title = 'CyberDigest — Daily Cybersecurity Intelligence',
  description = 'Automated daily cybersecurity news, educational blogs, and in-depth threat analysis. Powered by trusted sources and AI.',
  ogImage = '/og-default.png',
  ogType = 'website',
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://digest.jerome.co.in';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#06080D" />

  <title>{title}</title>
  <link rel="canonical" href={canonical} />

  <!-- Font Preloading — eliminates FOUT -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:site_name" content="CyberDigest" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="CyberDigest RSS" href="/rss.xml" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Analytics -->
  <script defer src="https://cloud.umami.is/script.js" data-website-id="33712f7e-11c8-491d-a647-a8bec81c3d5c"></script>
</head>
<body>
  <!-- 3D Particle Background -->
  <ParticleField />

  <Navbar />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- GSAP Animation System -->
  <Animations />
</body>
</html>
