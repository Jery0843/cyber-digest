{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "functions/**/*.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
